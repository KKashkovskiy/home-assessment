# Secrets come from the environment only. Export these in the shell, or copy this file to .env (git-ignored)
# and load it with `set -a; . ./.env; set +a`: Spring does not read .env itself. No key is needed to build or test.
OPENAI_API_KEY=
# Separate key for the eval simulator and judges, so evals never spend the app's budget (README A7).
EVAL_OPENAI_API_KEY=
