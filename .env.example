# Secrets come from the environment only. Export these in the shell, or copy this file to .env (git-ignored)
# and load it with `set -a; . ./.env; set +a`: Spring does not read .env itself. No key is needed to build or test.
OPENAI_API_KEY=
# Separate key for the eval simulator and judges, so evals never spend the app's budget (docs/design.md, A7).
EVAL_OPENAI_API_KEY=
# true lets evals spend OPENAI_API_KEY when EVAL_OPENAI_API_KEY is blank.
EVAL_ALLOW_SHARED_KEY=false
